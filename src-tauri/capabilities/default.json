{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas das janelas popup, settings e update",
  "windows": ["popup", "settings", "update"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus"
  ]
}
